# ═══════════════════════════════════════════════════════════════
#  LUMINOUS WILL WEB — Environment Variables
# ═══════════════════════════════════════════════════════════════
#  Copy this file to .env.local and fill in your values.
#  Vercel deployments: set these in Project Settings > Environment Variables.
#
#  Legend:
#    [REQUIRED]  — App will not function without this
#    [OPTIONAL]  — Feature degrades gracefully if missing
#    [AUTO]      — Set automatically by Vercel (do not set manually)
# ═══════════════════════════════════════════════════════════════


# ── VERCEL BLOB STORAGE ────────────────────────────────────────
# Used by: lib/queue.ts, lib/tokens.ts, lib/settings.ts
# Purpose: Stores the video queue (queue.json), OAuth tokens,
#          and app settings in Vercel Blob. This is the primary
#          data store — without it, the dashboard shows no data.
# How to get: Vercel Dashboard > Storage > Create Blob Store > Connect
# [REQUIRED]
BLOB_READ_WRITE_TOKEN=


# ── CRON SECRET ────────────────────────────────────────────────
# Used by: app/api/cron/post-scheduled/route.ts,
#          app/api/cron/generate-videos/route.ts
# Purpose: Protects cron endpoints from unauthorized access.
#          Vercel automatically injects this as a Bearer token
#          when calling cron routes defined in vercel.json.
# How to get: Vercel Dashboard > Project Settings > Environment Variables
#             > Add CRON_SECRET with a random string (e.g., openssl rand -hex 32)
# [REQUIRED for cron jobs to work]
CRON_SECRET=


# ── HF SPACES URL ─────────────────────────────────────────────
# Used by: app/api/cron/generate-videos/route.ts, app/page.tsx
# Purpose: URL of the Hugging Face Spaces Gradio app that runs
#          the Python video generation pipeline. The generate-videos
#          cron calls this to trigger new video creation.
# Note: NEXT_PUBLIC_ prefix makes this available in client-side code
#       (used on the home page to show the space link).
# Example: https://leoemp-luminous-will.hf.space
# [REQUIRED for video generation]
NEXT_PUBLIC_HF_SPACE_URL=


# ── APP URL ────────────────────────────────────────────────────
# Used by: All OAuth auth routes (youtube, tiktok, meta) for redirect URIs
# Purpose: The public URL of this deployed app. Used to construct
#          OAuth callback URLs like {APP_URL}/api/auth/youtube/callback.
#          Falls back to http://localhost:3000 in development.
# Note: NEXT_PUBLIC_ prefix makes it available client-side too.
# Example: https://luminous-will.vercel.app
# [REQUIRED for OAuth in production, optional in dev]
NEXT_PUBLIC_APP_URL=


# ═══════════════════════════════════════════════════════════════
#  YOUTUBE OAuth (Google Cloud Console)
# ═══════════════════════════════════════════════════════════════
# Used by: lib/tokens.ts, app/api/auth/youtube/route.ts,
#          app/api/auth/youtube/callback/route.ts
# Purpose: YouTube Data API v3 — uploads videos as YouTube Shorts.
# How to get:
#   1. Google Cloud Console > APIs & Services > Credentials
#   2. Create OAuth 2.0 Client ID (Web application)
#   3. Add redirect URI: {APP_URL}/api/auth/youtube/callback
#   4. Enable YouTube Data API v3 in the API library
# [OPTIONAL — YouTube posting won't work without these]
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=


# ═══════════════════════════════════════════════════════════════
#  TIKTOK OAuth (TikTok Developer Portal)
# ═══════════════════════════════════════════════════════════════
# Used by: lib/tokens.ts, app/api/auth/tiktok/route.ts,
#          app/api/auth/tiktok/callback/route.ts
# Purpose: TikTok Content Posting API — uploads videos to TikTok.
# How to get:
#   1. TikTok Developer Portal > Manage Apps > Create App
#   2. Add redirect URI: {APP_URL}/api/auth/tiktok/callback
#   3. Request "Video Upload" permission
# Note: TikTok uses "client_key" (not "client_id") in their API
# [OPTIONAL — TikTok posting won't work without these]
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=


# ═══════════════════════════════════════════════════════════════
#  META OAuth (Meta for Developers)
# ═══════════════════════════════════════════════════════════════
# Used by: lib/tokens.ts, app/api/auth/meta/route.ts,
#          app/api/auth/meta/callback/route.ts
# Purpose: Instagram Graph API + Facebook Pages API — posts Reels
#          to Instagram and videos to Facebook Pages.
# How to get:
#   1. Meta for Developers > My Apps > Create App
#   2. Add redirect URI: {APP_URL}/api/auth/meta/callback
#   3. Request permissions: pages_manage_posts, instagram_content_publish
# [OPTIONAL — Instagram/Facebook posting won't work without these]
META_APP_ID=
META_APP_SECRET=


# ═══════════════════════════════════════════════════════════════
#  ADMIN ALERTS (Slack / Discord Webhook)
# ═══════════════════════════════════════════════════════════════
# Used by: lib/notify-admin.ts
# Purpose: Sends failure alerts when cron jobs crash. Posts a
#          Slack-compatible JSON message to the webhook URL.
#          Without this, failures are only visible in Vercel logs.
# How to get:
#   Slack: Workspace Settings > Incoming Webhooks > Add to channel
#   Discord: Server Settings > Integrations > Webhooks > Copy URL
# [OPTIONAL — alerts still log to console without this]
ALERT_WEBHOOK_URL=
